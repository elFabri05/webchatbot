# --- Signal tracker MCP server -------------------------------------------
# Swap mock <-> real here; no code changes needed.
#   http(s)://...  -> Streamable HTTP transport
#   anything else  -> stdio: the value is the command line to launch
# Local (stdio, mock):
MCP_SIGNAL_SERVER="python -m mock_mcp.server"
# Docker / HTTP mock:
# MCP_SIGNAL_SERVER=http://mock-mcp:8001/mcp
# Production:
# MCP_SIGNAL_SERVER=https://signal-tracker.internal.example/mcp

# Optional bearer token sent to HTTP MCP servers
MCP_SIGNAL_TOKEN=

# Server exposing find_customer / create_ticket / handoff_to_human.
# Empty = same as MCP_SIGNAL_SERVER (the mock exposes both).
MCP_CUSTOMER_SERVER=

# Seconds per MCP tool call before the bot treats the tracker as down
MCP_CALL_TIMEOUT=15

# --- Mock MCP server -----------------------------------------------------
MOCK_DB_PATH=data/isp.db

# --- Claude / bot ---------------------------------------------------------
# Empty = SDK default credential chain (e.g. `ant auth login` profile).
ANTHROPIC_API_KEY=
BOT_MODEL=claude-opus-5-5
# Model for the running summary; empty = BOT_MODEL
BOT_SUMMARY_MODEL=
BOT_EFFORT=medium
BOT_MAX_TOOL_CALLS=5
BOT_HISTORY_WINDOW=10
BOT_TIMEZONE=Europe/Madrid
# Server-side refusal fallback (fallbacks="default")
BOT_FALLBACKS=true

# Conversation storage (separate from the mock MCP DB)
APP_DB_PATH=data/app.db
# Show tool calls + token usage in the chat page debug panel (turn off for real customers)
CHAT_DEBUG=true

# --- Langfuse (self-hosted tracing) ----------------------------------------
# true: `make up` also starts Langfuse (UI on http://localhost:3000) and the bot sends
# one trace per customer message, with PII masked. false: no Langfuse containers,
# nothing is sent.
LANGFUSE_ENABLED=true
# Where a local `make run` sends traces (start Langfuse with `make langfuse-up`).
# Inside Docker the app always uses http://langfuse-web:3000.
LANGFUSE_HOST=http://localhost:3000
# Local-only defaults. Change these before anything but localhost can reach Langfuse;
# the API keys and the login are only applied when Langfuse first creates its database.
# LANGFUSE_PUBLIC_KEY=pk-lf-local-chatbot
# LANGFUSE_SECRET_KEY=sk-lf-local-chatbot
# LANGFUSE_INIT_USER_EMAIL=admin@example.com
# LANGFUSE_INIT_USER_PASSWORD=chatbot-langfuse
# NEXTAUTH_SECRET=        # openssl rand -base64 32
# SALT=                   # openssl rand -base64 32
# ENCRYPTION_KEY=         # openssl rand -hex 32
# POSTGRES_PASSWORD=
# CLICKHOUSE_PASSWORD=
# MINIO_ROOT_PASSWORD=
# REDIS_AUTH=
